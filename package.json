{
  "name": "board-game-engine",
  "private": true,
  "version": "2.0.0",
  "description": "Play board games together: private hands on phones, shared board on the TV, Claude-playable seats.",
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "overrides": {
    "@types/three": "0.169.0",
    "three": "0.169.0"
  },
  "scripts": {
    "dev": "npm run dev -w server",
    "dev:client": "npm run dev -w client",
    "build": "npm run build -w client",
    "start": "npm run build -w client && npm run dev -w server",
    "test": "npm run test -w shared && npm run test -w server && npm run test -w client",
    "typecheck": "tsc -p client/tsconfig.json --noEmit && tsc -p server/tsconfig.json --noEmit",
    "autoplay": "npm run autoplay -w server --",
    "autoplay:brass": "npm run autoplay:brass -w server --",
    "stage:sh": "node tools/stage-secret-hitler.mjs"
  },
  "devDependencies": {
    "sharp": "^0.34.0",
    "typescript": "^5.6.0"
  }
}
